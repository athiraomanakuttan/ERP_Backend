# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ems

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_too
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Initial Admin (used by seed:admin script)
ADMIN_EMAIL=admin@ems.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FIRST_NAME=System

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Password reset email (SMTP)
# Use the SMTP settings supplied by your mailbox/hosting provider.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="EMS <no-reply@yourdomain.com>"
# Optional override; defaults to CLIENT_ORIGIN/reset-password
PASSWORD_RESET_URL=http://localhost:5173/reset-password
