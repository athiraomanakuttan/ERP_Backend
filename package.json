{
  "name": "ems-backend",
  "version": "1.0.0",
  "description": "Employee Management System - Backend (Express + TypeScript + MongoDB, Repository Pattern)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:admin": "ts-node src/seeders/adminSeeder.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "seed:employee-scopes": "ts-node src/seeders/employeePermissionScopeSeeder.ts",
    "repair:employee-code-index": "ts-node src/scripts/repairEmployeeCodeIndex.ts",
    "seed:resource-scopes": "ts-node src/seeders/resourcePermissionScopeSeeder.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.15.0",
    "docx": "^9.5.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "@types/pdfkit": "^0.13.8"
  }
}
